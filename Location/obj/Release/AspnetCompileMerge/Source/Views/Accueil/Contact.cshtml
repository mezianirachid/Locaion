@{ Layout = null; }

<header id="#top">
    @Html.Partial("_Header")
</header>


@{ ViewData["OnContact"] = "on";
@Html.Partial("_Menu"); }


<div class="modal fade" id="myModalSuccess" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header alert-success">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Information</h4>
            </div>
            <div class="modal-body">
                <span style="color:#000" id="SuccessMsg"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="myModalError" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header alert-danger">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Attention !</h4>
            </div>
            <div class="modal-body">
                <span style="color:#000" id="errorMsg"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
<div class="form-horizontal">
    <div class="row" style="border: 2px solid #ffd800; margin:5px">
        <h3>Notre adresse</h3>

        <div class="row cell-border" style="padding-left: 50px; padding-right: 50px;">
            <iframe src="https://www.google.com/maps/embed/v1/place?q=10250+Avenue+Plaza,+Montréal-Nord,+QC,+Canada&key=AIzaSyBFw0Qbyq9zTFTd-tUY6dZWTgaQzuU17R8"></iframe>
        </div>
        <hr />
        <div class="col-sm-6">
            <div class="col-xs-12 col-sm-6">
                <h3>Adresse</h3>
                <hr />
                <p>@ViewBag.Text108</p>
                <p><i class="fa fa-phone green" aria-hidden="true"></i><a href="tel:000000000">@ViewBag.Text109</a></p>
                <p><i class="fa fa-envelope purple" aria-hidden="true"></i><a href="mailto:@ViewBag.Text110">@ViewBag.Text110</a></p>
                <p>@ViewBag.Text111</p>
            </div>
        </div>
        
            <div class="col-sm-6" style="border: 1px #808080">
                <div class="col-sm-12">
                    <h3>Nous contacter</h3>
                    <hr />
                    <div>
                        <small class="text-muted">Ces informations resteront confidentielles.</small>
                        <form class="m-b-2" enctype="multipart/form-data">
                            <div>
                                <fieldset class="form-group">
                                    <label for="firstname">Prénom</label>
                                    <input type="text" class="form-control" id="prenom" name="prenom">
                                    <label class="m-t-1" for="lastname">Nom</label>
                                    <input type="text" class="form-control" id="nom" name="nom">
                                    <label class="m-t-1" for="mail">Adresse mail</label>
                                    <input type="email" class="form-control" id="courriel" name="courriel">
                                    <label class="m-t-1" for="mail">Téléphone</label>
                                    <input type="text" class="form-control" id="telephone" name="telephone">
                                    <label class="m-t-1" for="mail">Sujet</label>
                                    <input type="text" class="form-control" id="sujet" name="sujet">
                                    <label for="message">votre message</label>
                                    <textarea class="form-control" id="body" name="body" rows="6"></textarea>
                                    <div class="col-md-3 text-center">
                                        <img id="image_upload_preview" class="img-circle" src="~/Content/Images/contractor-avator.png" />
                                        <br />
                                        <input type="file" id="inputFile" style="max-width: 500px" />
                                        @*<label for="inputFile" class="btn btn-success">Joindre un fichier</label>*@
                                    </div>
                                </fieldset>
                                <button class="btn pull-left" id="contact_button" onclick="EnvoyerFormulaire()">Envoyer</button>
                            </div>
                            <br />
                        </form>
                    </div>
                </div>
            </div>        
    </div>
</div>






<!--

~~~~~~~~~End of the main content~~~~~~~~~~~~~

-->
<!--

~~~~~~~~~Start of the footer~~~~~~~~~~~~~

-->

<footer class="m-t-3">
    @Html.Partial("_Footer")
</footer>

