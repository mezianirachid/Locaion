    @if (User.IsInRole("Admin"))
    {
        <button class="admin-toggle" id="adminToggle" onclick="location.href='@Url.Action("Index", "Admin")'">
            <i class="fas fa-cog"></i>
        </button>
    }

    <div id="notification" class="notification"></div>

    <!-- jQuery et Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $.validator.methods.number = function (value, element) {
            value = value.replace(/\s/g, '');
            return this.optional(element) || /^-?\d+(,\d+)?$/.test(value);
        };

        $.validator.methods.range = function (value, element, param) {
            var globalizedValue = value.replace(/\s/g, '').replace(",", ".");
            var numericValue = parseFloat(globalizedValue);
            return this.optional(element) || (numericValue >= param[0] && numericValue <= param[1]);
        };
    </script>

    <script>
        // ========== FONCTIONS GLOBALES ==========
        function showNotification(message, type) {
            var $notif = $('#notification');
            $notif.text(message).removeClass().addClass('notification ' + type).addClass('show');
            setTimeout(function () {
                $notif.removeClass('show');
            }, 5000);
        }

        function scrollToSection(sectionId) {
            var section = document.getElementById(sectionId);
            if (section) {
                var header = document.querySelector('header');
                var headerHeight = header ? header.offsetHeight : 0;
                window.scrollTo({
                    top: section.offsetTop - headerHeight,
                    behavior: 'smooth'
                });
                console.log('Défilement vers #' + sectionId + ' réussi.');
            } else {
                console.warn('Section introuvable lors de l\'appel à scrollToSection : #' + sectionId);
            }
        }

        function fetchUnreadCount() {
            $.ajax({
                url: '@Url.Action("GetUnreadEmailCount", "Admin")',
                type: 'GET',
                success: function (data) {
                    console.log('Réponse reçue :', data); // À supprimer en production
                    var $badge1 = $('#unreadCount1');
                    var $badge2 = $('#unreadCount2');

                    // Si les badges n'existent pas, on ne fait rien (utilisateur non admin)
                    if ($badge1.length === 0 && $badge2.length === 0) return;

                    var count = parseInt(data, 10);
                    var visible = !isNaN(count) && count > 0;

                    // Mise à jour du premier badge
                    if ($badge1.length) {
                        if (visible) {
                            $badge1.text(count).addClass('badge-visible').removeClass('hidden');
                        } else {
                            $badge1.removeClass('badge-visible').addClass('hidden');
                        }
                    }

                    // Mise à jour du second badge
                    if ($badge2.length) {
                        if (visible) {
                            $badge2.text(count).addClass('badge-visible').removeClass('hidden');
                        } else {
                            $badge2.removeClass('badge-visible').addClass('hidden');
                        }
                    }
                },
                error: function () {
                    $('#unreadCount1, #unreadCount2').removeClass('badge-visible').addClass('hidden');
                }
            });
        }

        // ========== INITIALISATION ==========
        $(document).ready(function () {
            // Menu hamburger
            $('#menuToggle').on('click', function () {
                $(this).toggleClass('active');
                $('#navLinks').toggleClass('active');
            });

            // Gestion des sous-menus en mobile
            $('.menu-parent').on('click', function (e) {
                if ($(window).width() <= 992) {
                    e.preventDefault();
                    var $parent = $(this).closest('.dropdown');
                    var $submenu = $parent.children('.submenu');
                    $('#navLinks .dropdown').not($parent).removeClass('open').children('.submenu').slideUp(200);
                    $parent.toggleClass('open');
                    $submenu.stop(true, true).slideToggle(200);
                }
            });

            // Fermer le menu hamburger après clic sur un lien (sauf dropdown parents)
            $('#navLinks a').on('click', function () {
                if ($(window).width() <= 992) {
                    $('#menuToggle').removeClass('active');
                    $('#navLinks').removeClass('active');
                    $('#navLinks .dropdown').removeClass('open').children('.submenu').hide();
                }
            });

            // Gestion du menu utilisateur (desktop)
            var $userMenuToggle = $('#userMenuToggle');
            var $userMenu = $('#userMenu');

            if ($userMenuToggle.length) {
                $userMenuToggle.on('click', function (e) {
                    e.preventDefault();
                    $userMenu.toggleClass('open');
                });

                $(document).on('click', function (e) {
                    if (!$(e.target).closest($userMenu).length) {
                        $userMenu.removeClass('open');
                    }
                });
            }

            // Effet de scroll sur le header
            $(window).on('scroll', function () {
                if ($(this).scrollTop() > 100) {
                    $('#header').addClass('scrolled');
                } else {
                    $('#header').removeClass('scrolled');
                }
            });

            // ===== GESTION DES ANCRES AVEC MUTATIONOBSERVER =====
            function setupAnchorObserver() {
                if (!window.location.hash) return;

                var hash = window.location.hash.substring(1);
                var targetElement = document.getElementById(hash);

                if (targetElement) {
                    // Déjà présent
                    scrollToSection(hash);
                } else {
                    console.log('En attente de l\'élément #' + hash + '...');

                    // Créer un observer pour attendre que l'élément apparaisse
                    var observer = new MutationObserver(function(mutations) {
                        if (document.getElementById(hash)) {
                            scrollToSection(hash);
                            observer.disconnect(); // Arrêter l'observation
                        }
                    });

                    // Observer tout le body et ses descendants
                    observer.observe(document.body, {
                        childList: true,
                        subtree: true
                    });

                    // Timeout de sécurité après 5 secondes
                    setTimeout(function() {
                        observer.disconnect();
                        if (!document.getElementById(hash)) {
                            console.error('L\'élément #' + hash + ' n\'a pas été trouvé après 5 secondes.');
                        }
                    }, 5000);
                }
            }

            // Appeler l'observateur au chargement
            setupAnchorObserver();

            // Également après chargement complet (au cas où)
            $(window).on('load', function () {
                if (window.location.hash) {
                    var hash = window.location.hash.substring(1);
                    scrollToSection(hash);
                }
            });

            // Gestion des clics sur les liens avec ancre (pour les liens internes)
            $('a[href*="#"]').on('click', function (e) {
                var href = $(this).attr('href');
                if (href && href.indexOf('#') !== -1 && (href.indexOf('#') === 0 || href.indexOf(window.location.pathname) !== -1)) {
                    var hash = href.split('#')[1];
                    var target = $('#' + hash);
                    if (target.length) {
                        e.preventDefault();
                        scrollToSection(hash);
                    } else {
                        console.warn('Cible introuvable lors du clic : #' + hash);
                    }
                }
            });

            // Notification depuis TempData
            @*var msg = '@TempData["NotificationMessage"]';
            var type = '@TempData["NotificationType"]';*@

            var msg = @Html.Raw(Json.Encode(TempData["NotificationMessage"]));
            var type = @Html.Raw(Json.Encode(TempData["NotificationType"]));


            if (msg) {
                showNotification(msg, type || 'info');
            }

            // ========== BADGE MESSAGES NON LUS ==========
            // On vérifie si au moins un badge existe (donc utilisateur admin)
            if ($('#unreadCount1').length || $('#unreadCount2').length) {
                fetchUnreadCount();
                setInterval(fetchUnreadCount, 60000); // Rafraîchir toutes les 60 secondes
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>