@{
    ViewBag.Title = "Tableau de bord";
}

@section Styles {
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .stat-card {
            background: linear-gradient(135deg, #f8fbff, #ffffff);
            border: 1px solid #dbeafe;
            border-radius: 16px;
            padding: 24px 16px;
            text-align: center;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-md);
            }

            .stat-card i {
                font-size: 2.5rem;
                color: var(--primary);
                margin-bottom: 15px;
            }

            .stat-card h3 {
                font-size: 1.1rem;
                color: var(--gray);
                margin-bottom: 10px;
            }

            .stat-card .stat-number {
                font-size: 2.2rem;
                font-weight: 700;
                color: var(--dark);
            }

        .recent-section {
            margin-top: 50px;
        }

            .recent-section h2 {
                font-size: 1.6rem;
                color: var(--primary);
                margin-bottom: 20px;
                font-family: 'Playfair Display', serif;
            }

        .recent-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

            .recent-table th {
                background: linear-gradient(135deg, var(--primary), var(--primary-dark));
                color: white;
                font-weight: 600;
                padding: 12px 15px;
                text-align: left;
            }

            .recent-table td {
                padding: 12px 15px;
                border-bottom: 1px solid var(--border);
            }

            .recent-table tr:last-child td {
                border-bottom: none;
            }

            .recent-table tr:hover {
                background: #f8fbff;
            }
    </style>
}

<h1>Tableau de bord</h1>
<p>Bienvenue, @User.Identity.Name ! Voici un résumé de vos données.</p>

<div class="stats-grid">
    <div class="stat-card">
        <i class="fas fa-building"></i>
        <h3>Immeubles</h3>
        <div class="stat-number">@ViewBag.ImmeublesCount</div>
    </div>
    <div class="stat-card">
        <i class="fas fa-door-open"></i>
        <h3>Appartements</h3>
        <div class="stat-number">@ViewBag.AppartementsCount</div>
    </div>
    <div class="stat-card">
        <i class="fas fa-user-friends"></i>
        <h3>Locataires</h3>
        <div class="stat-number">@ViewBag.LocatairesCount</div>
    </div>
    <div class="stat-card">
        <i class="fas fa-file-signature"></i>
        <h3>Baux</h3>
        <div class="stat-number">@ViewBag.BauxCount</div>
    </div>
    <div class="stat-card">
        <i class="fas fa-credit-card"></i>
        <h3>Paiements</h3>
        <div class="stat-number">@ViewBag.PaiementsCount</div>
    </div>
</div>

<div class="recent-section">
    <h2>Derniers baux</h2>
    <table class="recent-table">
        <thead>
            <tr>
                <th>N° Bail</th>
                <th>Appartement</th>
                <th>Locataire</th>
                <th>Date début</th>
                <th>Prix</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bail in ViewBag.DerniersBaux)
            {
                <tr>
                    <td>@bail.NumeroBail</td>

                    <td>@(bail.Appartements != null ? bail.Appartements.AdresseAppartement : "-")</td>

                    <td>
                        @(bail.Locataires != null
            ? bail.Locataires.PrenomLocataire + " " + bail.Locataires.NomLocataire
            : "-")
                    </td>


                    <td>
                        @(bail.DateDebut != DateTime.MinValue  ? bail.DateDebut.ToString("dd/MM/yyyy")  : "-")
                    </td>
                    <td>@bail.Prix.ToString("C", new System.Globalization.CultureInfo("fr-CA"))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="recent-section">
    <h2>Derniers paiements</h2>
    <table class="recent-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Bail</th>
                <th>Montant</th>
                <th>Moyen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var paiement in ViewBag.DerniersPaiements)
            {
                <tr>
                    <td>@(paiement.DatePayement != null ? paiement.DatePayement.ToString("dd/MM/yyyy") : "-")</td>
                    <td>@(paiement.Baux != null ? paiement.Baux.NumeroBail : "-")</td>
                    <td>@(paiement.Montant != null ? paiement.Montant.ToString("C", new System.Globalization.CultureInfo("fr-CA")) : "-")</td>
                    <td>@(paiement.MoyenPayements != null ? paiement.MoyenPayements.NomMoyenPayement : "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
