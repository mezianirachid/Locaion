@model Location.DAL.Appartements

@{
    ViewBag.Title = "Supprimer l'appartement";
}

<h2 class="mb-4"><i class="fas fa-trash-alt me-2"></i>Supprimer l'appartement</h2>

<div class="card shadow border-danger">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Confirmation de suppression</h4>
    </div>
    <div class="card-body">
        <h5 class="text-danger">Êtes-vous sûr de vouloir supprimer cet appartement ?</h5>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Immeubles.NomImmeuble)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Immeubles.NomImmeuble)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TypeAppartements.NomTypeAppartement)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.TypeAppartements.NomTypeAppartement)</dd>

            <dt class="col-sm-3">@Html.LabelFor(model => model.AdresseAppartement, "Adresse", new { @class = "form-label" })</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.AdresseAppartement)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NumeroEtage)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NumeroEtage)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Superficie)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Superficie)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StatutAppartement)</dt>
            <dd class="col-sm-9">
                <span class="badge bg-@(Model.StatutAppartement == "A" ? "success" : "secondary")">
                    @(Model.StatutAppartement == "A" ? "Disponible" : "Occupé")
                </span>
            </dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-actions">
                <button type="submit" class="btn btn-danger"><i class="fas fa-check me-1"></i>Confirmer la suppression</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Retour à la liste</a>
            </div>
        }
    </div>
</div>