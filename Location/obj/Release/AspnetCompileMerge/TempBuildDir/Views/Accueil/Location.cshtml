        <!-- Cards search results -->
        <div class="row">
            @{ if (ViewBag.Text31 != null && ViewBag.Text31 != "")
                {
    <div class="col-xs-12 col-sm-6 col-md-4">
        <article class="card">
            <div class="card-block text-xs-center head">
                <h4 class="card-title">@ViewBag.Text31</h4>
                <h6 class="card-subtitle">@ViewBag.Text32</h6>
            </div>
            <figure>
                <img src="/UploadedFiles/maison1_small.jpg" class="img-fluid hidden-sm-up" alt="img/maison1_small.jpge">
                <img src="/UploadedFiles/maison1_medium.jpg" class="img-fluid hidden-xs-down hidden-lg-up" alt="img/maison1_medium.jpg">
                <img src="/UploadedFiles/maison1_large.jpg" class="img-fluid hidden-md-down" alt="img/maison1_large.jpg">
            </figure>
            <div class="card-block text-xs-center">
                <p class="card-text">@ViewBag.Text32</p>
                <figure class="description">
                    <span><i class="fa fa-bed" aria-hidden="true"></i>@ViewBag.Text33</span>
                    <span><i class="fa fa-paper-plane" aria-hidden="true"></i>@ViewBag.Text34</span>
                    <span><i class="fa fa-tint" aria-hidden="true"></i>@ViewBag.Text35</span>
                </figure>
                <a href="#" class="card-link"><i class="fa fa-eye m-r-1" aria-hidden="true"></i>Voir</a>
            </div>
        </article>
    </div>} }


