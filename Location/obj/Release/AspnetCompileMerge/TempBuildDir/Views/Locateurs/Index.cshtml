@model IEnumerable<Location.DAL.Locateur>

@{
    ViewBag.Title = "Liste des locateurs";
}

<h2>Liste des locateurs</h2>

<p>
    @Html.ActionLink("Créer un nouveau", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Prenom)</th>
            <th>@Html.DisplayNameFor(model => model.Nom)</th>
            <th>@Html.DisplayNameFor(model => model.TelPrincipal)</th>
            <th>@Html.DisplayNameFor(model => model.Courriel)</th>
            <th>@Html.DisplayNameFor(model => model.Statut)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Prenom)</td>
                <td>@Html.DisplayFor(modelItem => item.Nom)</td>
                <td>@Html.DisplayFor(modelItem => item.TelPrincipal)</td>
                <td>@Html.DisplayFor(modelItem => item.Courriel)</td>
                <td>@Html.DisplayFor(modelItem => item.Statut)</td>
                <td>
                    @Html.ActionLink("Détails", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-info" })
                    @Html.ActionLink("Modifier", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-warning" })
                    @Html.ActionLink("Supprimer", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>