@model Location.Models.RegisterViewModel
@{
    ViewBag.Title = "Création de compte";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<script src="~/Scripts/InputMask.js.js"></script>*@

<br />
<h2>@ViewBag.Title.</h2>
<hr />
@if (@ViewBag.succes != null)
{
   
    <span class="alert alert-success">@ViewBag.succes</span>
}

@*@if (@TempData["Message"] != null)
{
    <br />
    <span class="alert alert-success">@TempData["Message"]</span>}
<br />*@

@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "text-danger" })
    <div class="form-group">
        @Html.Label("Nom", new { @class = "col-md-2 control-label required" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Nom, new { @class = "form-control", @autocomplete = "off" })
        </div>
    </div>
    <div class="form-group">
        @Html.Label("Prénom", new { @class = "col-md-2 control-label required" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Prenom, new { @class = "form-control", @autocomplete = "off" })
        </div>
    </div>
    <div class="form-group">
        @Html.Label("Courriel", new { @class = "col-md-2 control-label required" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @autocomplete = "off" })
        </div>
    </div>

    <div class="form-group">
        @Html.Label("Téléphone", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Telephone, new { htmlAttributes = new { @class = "form-control", id = "Telephone", title = "Téléphone", mask = "(999)-999-9999", autocomplete = "off" } })
            @Html.ValidationMessageFor(model => model.Telephone, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.Label("Nom utilisateur", new { @class = "col-md-2 control-label required" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", autocomplete = "off" })
        </div>
    </div>
    <div class="form-group">
        @Html.Label("Mot de passe", new { @class = "col-md-2 control-label required" })
        <div class="col-md-10">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "off" })
        </div>
    </div>
    <div class="form-group">
        @Html.Label("Confirmation", new { @class = "col-md-2 control-label required" })
        <div class="col-md-10">
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "off" })
        </div>
    </div>
    @*if (@ViewBag.Name != null)
    {
        <div class="form-group">
            @Html.Label("Rôle utilisateur", htmlAttributes: new { @class = "control-label col-md-2 required" })
