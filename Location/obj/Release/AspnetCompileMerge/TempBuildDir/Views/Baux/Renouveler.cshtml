@model Location.Models.RenouvellementBailViewModel

@{
    ViewBag.Title = "Renouvellement du bail";
}

<h2 class="mb-4">
    <i class="fas fa-sync-alt me-2 text-success"></i>Renouvellement du bail
</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Création d'un nouveau bail à partir de l'original</h4>
        </div>
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            @Html.HiddenFor(model => model.BailOriginalId)
            @Html.HiddenFor(model => model.LocataireId)
            @Html.HiddenFor(model => model.AppartementId)

            <!-- Informations statiques du bail original -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-header">Locataire</div>
                        <div class="card-body">
                            @Html.DisplayFor(model => model.LocataireNomComplet)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-header">Appartement</div>
                        <div class="card-body">
                            @Html.DisplayFor(model => model.AppartementAdresse)
                        </div>
                    </div>
                </div>
            </div>

            <!-- Champs modifiables -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.NouvelleDateDebut, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.NouvelleDateDebut, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                    @Html.ValidationMessageFor(model => model.NouvelleDateDebut, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.NouvelleDateFin, new { @class = "form-label fw-bold" })
                    @Html.EditorFor(model => model.NouvelleDateFin, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                    <small class="form-text text-muted">Laissez vide pour un bail à durée indéterminée.</small>
                    @Html.ValidationMessageFor(model => model.NouvelleDateFin, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.NouveauLoyer, new { @class = "form-label fw-bold" })
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        @Html.EditorFor(model => model.NouveauLoyer, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01", min = "0" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.NouveauLoyer, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.NouvellesCharges, new { @class = "form-label fw-bold" })
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        @Html.EditorFor(model => model.NouvellesCharges, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01", min = "0" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.NouvellesCharges, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Commentaires, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(model => model.Commentaires, 5, 40, new { @class = "form-control", placeholder = "Conditions particulières, remarques..." })
                <small class="form-text text-muted">Ces commentaires seront inclus dans la lettre de renouvellement.</small>
                @Html.ValidationMessageFor(model => model.Commentaires, "", new { @class = "text-danger" })
            </div>

            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                Les autres conditions du bail (stationnements, inclusions, etc.) seront reprises à l'identique du bail original.
                Vous pourrez les modifier ultérieurement dans la fiche du nouveau bail.
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-check me-1"></i>Confirmer le renouvellement
                </button>
                <a href="@Url.Action("Details", new { id = Model.BailOriginalId })" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Annuler
                </a>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}