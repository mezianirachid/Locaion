@model IEnumerable<Location.DAL.Immeubles>

@{
    ViewBag.Title = "Immeubles";
}

<h2 class="mb-4"><i class="fas fa-building me-2"></i>Gestion des immeubles</h2>

<p>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus-circle me-1"></i>Ajouter un immeuble
    </a>
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-building me-1"></i> @Html.DisplayFor(modelItem => item.NomImmeuble)
                    </h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        <i class="fas fa-map-marker-alt text-muted me-2"></i> @Html.DisplayFor(modelItem => item.AdresseImmeuble)
                    </p>
                    <p class="card-text">
                        <i class="fas fa-info-circle text-muted me-2"></i> @Html.DisplayFor(modelItem => item.DescriptionImmeuble)
                    </p>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-@(item.StatutImmeuble == "A" ? "success" : "secondary")">
                            @(item.StatutImmeuble == "A" ? "Actif" : "Inactif")
                        </span>
                        <small class="text-muted">
                            <i class="fas fa-calendar-alt me-1"></i> @item.Annee
                        </small>
                    </div>
                    <div class="mt-3 d-flex justify-content-around">
                        <span title="Étages"><i class="fas fa-layer-group"></i> @item.nbEtages</span>
                        <span title="Stationnements int."><i class="fas fa-warehouse"></i> @item.nbStationnementsInt</span>
                        <span title="Stationnements ext."><i class="fas fa-car"></i> @item.nbStationnementsExt</span>
                    </div>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-between">
                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-warning">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-info-circle"></i> Détails
                    </a>
                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-trash-alt"></i> Supprimer
                    </a>
                </div>
            </div>
        </div>
    }
</div>