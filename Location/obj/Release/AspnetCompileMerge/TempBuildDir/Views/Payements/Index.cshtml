@model IEnumerable<Location.DAL.Payements>

@{
    ViewBag.Title = "Liste des paiements";
}

<h2 class="mb-4">
    <i class="fas fa-money-bill-wave me-2 text-primary"></i>Liste des paiements
    <small class="text-muted">(@Model.Count() paiements)</small>
</h2>

<!-- Bouton d'ajout avec espacement -->
<div class="d-flex justify-content-between mb-3">
    @Html.ActionLink("Enregistrer un paiement", "Create", null, new { @class = "btn btn-primary" })
    <span class="text-muted">Utilisez les filtres ci-dessous pour affiner la recherche</span>
</div>

<!-- Filtres avec design amélioré -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filtres</h5>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("Index", "Payements", FormMethod.Get, new { @class = "row g-3" }))
        {
            <div class="col-md-3">
                <label for="annee" class="form-label fw-semibold">Année</label>
                @Html.DropDownList("annee", (SelectList)ViewBag.Annees, "Toutes", new { @class = "form-select" })
            </div>
            <div class="col-md-3">
                <label for="mois" class="form-label fw-semibold">Mois</label>
                @Html.DropDownList("mois", (SelectList)ViewBag.Mois, "Tous", new { @class = "form-select" })
            </div>
            <div class="col-md-4">
                <label for="bailId" class="form-label fw-semibold">Bail</label>
                @Html.DropDownList("bailId", (SelectList)ViewBag.Baux, "Tous", new { @class = "form-select" })
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i>Filtrer</button>
            </div>
            <div class="col-md-12 text-end mt-2">
                @Html.ActionLink("Réinitialiser", "Index", null, new { @class = "btn btn-outline-secondary btn-sm" })
            </div>
        }
    </div>
</div>

<!-- Tableau responsive avec style amélioré -->
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Bail</th>
                <th>Période</th>
                <th>Date paiement</th>
                <th>Montant</th>
                <th>Moyen</th>
                <th>Statut</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                // Récupération sécurisée des données du bail et du locataire (sans opérateur ?.)
                var bail = item.Baux;
                var locataire = bail != null ? bail.Locataires : null;
                var nomComplet = locataire != null ? locataire.NomLocataire + " " + locataire.PrenomLocataire : "";

                // Pour le mois
                var moisNom = item.Mois.HasValue ? System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(item.Mois.Value) : "";

                // Pour la date de paiement formatée
                var datePaiementFormatted = item.DatePayement.HasValue ? item.DatePayement.Value.ToString("dd/MM/yyyy") : "-";

                <tr>
                    <td>
                        @if (bail != null)
                        {
                            <span class="fw-semibold">@bail.NumeroBail</span><br />
                            <small class="text-muted">@nomComplet</small>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (item.Mois.HasValue)
                        {
                            @moisNom @item.Annee
                        }
                        else
                        {
                            @item.Annee
                        }
                    </td>
                    <td>@datePaiementFormatted</td>
                    <td><span class="fw-bold text-success">@Html.DisplayFor(modelItem => item.Montant) $</span></td>
                    <td>@Html.DisplayFor(modelItem => item.MoyenPayements.NomMoyenPayement)</td>
                    <td>
                        @if (item.Statut == "A")
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i>Payé</span>
                        }
                        else if (item.Statut == "E")
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="fas fa-clock me-1"></i>En attente</span>
                        }
                        else if (item.Statut == "I")
                        {
                            <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="fas fa-times-circle me-1"></i>Annulé</span>
                        }
                        else
                        {
                            <span class="badge bg-info rounded-pill px-3 py-2">@item.Statut</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info" title="Détails" data-bs-toggle="tooltip">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-warning" title="Modifier" data-bs-toggle="tooltip">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" title="Supprimer" data-bs-toggle="tooltip">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Message si aucun résultat -->
@if (!Model.Any())
{
    <div class="alert alert-info text-center py-4">
        <i class="fas fa-info-circle fa-2x mb-3"></i>
        <h5>Aucun paiement trouvé</h5>
        <p>Essayez de modifier vos filtres ou créez un nouveau paiement.</p>
    </div>
}

@section Scripts {
    <script>
        // Activer les tooltips Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
}