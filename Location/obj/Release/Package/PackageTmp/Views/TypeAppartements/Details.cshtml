@model Location.DAL.TypeAppartements

@{
    ViewBag.Title = "Détail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Détails</h2>
<hr />
<div>


    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayName("Nom")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NomTypeAppartement)
        </dd>

        <dt>
            @Html.DisplayName("Description")
        </dt>


        <dd>
            @Html.DisplayFor(model => model.DescriptionTypeAppartement)
        </dd>

    </dl>
</div>



<div class="form-group">
    <div class="col-md-6">
        @Html.ActionLink("Retour à la liste", "Index", null, new { @class = "btn btn-primary btn-large" })
        
        <li class="btn btn-sm">
            <a href="@Url.Action("Edit", "TypeAppartements", new { id = Model.Id })" class="btn btn-success btn-large">Édition</a>
        </li>
    </div>
</div>