@model Location.DAL.MoyenPayements

@{
    ViewBag.Title = "Suppression";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Suppression</h2>

<h3>Êtes-vous sûr de vouloir supprimer?</h3>
<div>
    <h4>Moyens de payements</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.NomMoyenPayement )
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NomMoyenPayement)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DescriptionMoyenPayement)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DescriptionMoyenPayement)
        </dd>

       

    </dl>

    @using (Html.BeginForm()) 
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Suppression " class="btn btn-default" /> |
            @Html.ActionLink("Retour", "Index")
        </div>
    }
</div>
