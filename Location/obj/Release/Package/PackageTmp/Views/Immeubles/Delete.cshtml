@model Location.DAL.Immeubles

@{
    ViewBag.Title = "Supprimer l'immeuble";
}

<h2 class="mb-4"><i class="fas fa-trash-alt me-2"></i>Supprimer l'immeuble</h2>

<div class="card shadow border-danger">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Confirmation de suppression</h4>
    </div>
    <div class="card-body">
        <h5 class="text-danger">Êtes-vous sûr de vouloir supprimer cet immeuble ?</h5>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NomImmeuble)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NomImmeuble)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AdresseImmeuble)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.AdresseImmeuble)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StatutImmeuble)</dt>
            <dd class="col-sm-9">
                <span class="badge bg-@(Model.StatutImmeuble == "A" ? "success" : "secondary")">
                    @(Model.StatutImmeuble == "A" ? "Actif" : "Inactif")
                </span>
            </dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.nbEtages)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.nbEtages)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.nbStationnementsInt)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.nbStationnementsInt)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.nbStationnementsExt)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.nbStationnementsExt)</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-actions">
                <button type="submit" class="btn btn-danger"><i class="fas fa-check me-1"></i>Confirmer la suppression</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Retour à la liste</a>
            </div>
        }
    </div>
</div>