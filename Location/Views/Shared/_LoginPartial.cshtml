@if (User.Identity.IsAuthenticated)
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <span class="navbar-text text-white me-2">
                <i class="fas fa-user"></i> Bonjour, @User.Identity.Name
            </span>
        </li>
        <li class="nav-item">
            @*@Html.ActionLink("Déconnexion", "LogOff", "Account", null, new { @class = "nav-link" })*@
            <a href="/Account/LogOff" class="btn">Déconnexion</a>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            @*@Html.ActionLink("Connexion", "Login", "Account", null, new { @class = "nav-link" })*@
            <a href="/Account/Login" class="btn">Connexion</a>
        </li>
    </ul>
}