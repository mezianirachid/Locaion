                              '<td style="font-size: 11px;text-align:right">' + ((TypePrelevement != 'null' && TypePrelevement != '--- Veuillez choisir ---' && TypePrelevement != '') ? "Type prélèvement: " + TypePrelevement : '') + '</td>' +
                            '</tr>' +
