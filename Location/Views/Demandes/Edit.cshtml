<!-- definition des masques-->
@section Scripts
    {
    <!-- debut seter les hint sur les priorités-->
    <script type="text/javascript">
        $(function () {
            $("[id*=Priorite] option").each(function (i) {
                var title = "";
                if (i > 0) {
                    if ($(this).val() == 1) title = "Cas exceptionnels, après autorisation verbale obtenue du laboratoire. ";
                    if ($(this).val() == 2) title = "Les patients hospitalisés de même que les patients qui se présentent à l’urgence ayant une présentation clinique ou radiologique compatible avec un diagnostic de COVID-19 (incluant les tests requis pour la levée d’isolement).";
                    if ($(this).val() == 3) title = "Les professionnels de la santé symptomatiques en contact direct avec les patients, incluant les services ambulanciers symptomatiques ET susceptibles d’exposer ou d’avoir exposé la clientèle ou dont le retrait causerait un bris de service (incluant tests requis pour mesures de retour au travail).";
                    if ($(this).val() == 4) title = "Les résidents de centres d’hébergement de soins de longue durée(CHSLD) et de résidences privées pour aînés (RPA) symptomatiques ou présence d’une éclosion potentielle d’infection respiratoire (au moins deux cas) ou décès inattendu avec une cause respiratoire infectieuse suspectée; aussi, personnes habitant d’autres milieux à risque (ex. : refuges pour itinérants, etc.).";
                    if ($(this).val() == 5) title = "Les personnes symptomatiques vivant dans les régions éloignées, les communautés isolées et venant des Premières Nations/Inuit qui ont un accès limité à un hôpital."; if ($(this).val() == 6) title = "Cas exceptionnels, après autorisation verbale obtenue du laboratoire. ";
                    if ($(this).val() == 6) title = "Les premiers répondants ou travailleurs du système de sécurité publique (ex. : policiers et pompiers, agents des services correctionnels) symptomatiques et autres travailleurs fournissant des services jugés critiques/essentiels.";
                    if ($(this).val() == 7) title = "Les personnes symptomatiques de la communauté sur autorisation du directeur de santé publique. ";
                    $(this).attr("title", title);
                }
            });
        });
    </script>
    <!-- fin seter les hint sur les priorités-->
    <!--  ******************* debut Gestion des mask ****************** -->
    <script src="~/Scripts/jquery.maskedinput.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $("#Telephone").mask("(999) 999-9999");
        });

        $(function () {
            $("#Ramq").mask("aaaa99999999");
        });

        $(function () {
            $("#CodePostal").mask("a9a 9a9");
        });

        $(function () {
            $("#DateNaissance").mask("99-99-9999");
        });
        $(function () {
            $("#DateEntree").mask("99-99-9999");
        });

        $(function () {
            $("#DateRdv").mask("99-99-9999");
        });
        $(function () {
            $("#HeureRdv").mask("99:99");
        });

    </script>
    <script>
        $('#Ramq').focusout(function () {
            var str = $('#Ramq').val();
            if (str.includes("__")) {
                $(this).val('');
            }
        });
        $('#Ramq').keyup(function () {
            var str = $('#Ramq').val();
            var res = str.substring(0, 1);
            if (res == '_') {
                $(this).val('');
            }
        });

        $('#CodePostal').focusout(function () {
            var str = $('#CodePostal').val();
            if (str.includes("__")) {
                $(this).val('');
            }
        });
        $('#CodePostal').keyup(function () {
            var str = $('#CodePostal').val();
            var res = str.substring(0, 1);
            if (res == '_') {
                $(this).val('');
            }
        });

        $('#Telephone').focusout(function () {
            var str = $('#Telephone').val();
            if (str.includes("__")) {
                $(this).val('');
            }
        });
        $('#Telephone').keyup(function () {
            var str = $('#Telephone').val();
            var res = str.substring(0, 2);
            if (res == '(_') {
                $(this).val('');
            }
