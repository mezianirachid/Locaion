                            '<td colspan="2">' + Nom + '&nbsp;&nbsp;&nbsp;' + Prenom + '</td>' +
                            '</tr>' +
                            '<tr>' +
                              '<td style="font-size: 11px;">  ' + ((DateNaissance != '' && DateNaissance != 'null') ? "Né(e) le: " + DateNaissance : '') + '</td>' +
                               '<td style="font-size: 11px;text-align:right">' + (Matricule != 'null' ? TypeUsager + ":#" + Matricule : TypeUsager) + '</td>' +
                            '</tr>' +
                            '<tr>' +
                              '<td style="font-size: 11px;"> ' + ((CodePostal != '' && CodePostal != 'null') ? "CP: " + CodePostal : '') + '</td>' +
                              '<td style="font-size: 11px;text-align:right">' + ((Telephone != '' && Telephone != 'null') ? "Tél: " + Telephone : '') + '</td>' +
