            var TypePrelevement = document.getElementById("TypePrelevementGroup");
            TypePrelevement = TypePrelevement.options[TypePrelevement.selectedIndex].text;

            var Pays = document.getElementById("Pays");
            Pays = Pays.options[Pays.selectedIndex].text;
            var Region = document.getElementById("Destination").value;

            var ImageCalendrier = document.getElementById("myImage").src;

            //alert(Telephone);
            if (Priorite == '--- Veuillez choisir ---') Priorite = '';
            var CouleurPriorite = Priorite == 'STAT' ? "ROUGE" : Priorite == 'P1' ? "ROUGE" : Priorite == 'P2' ? "JAUNE" : Priorite == 'P3' ? "JAUNE" : Priorite == 'P4' ? "VERT" : Priorite == 'P5' ? "VERT" : Priorite == 'P6' ? "VERT" : '';
            var couleurPriorite = CouleurPriorite.replace(/[()\n\r]+|[\s]{2,}/g, '');
            couleurPriorite = (couleurPriorite != '' && couleurPriorite != 'null') ? (' (' + couleurPriorite.toUpperCase() + ')') : '';

            if (Priorite.length != 0)
            Priorite = "Priorité: " + Priorite;
            //alert(Matricule);

            var Site = document.getElementById("Site");
            Site = Site.options[Site.selectedIndex].text;

            var content1 =
                  '<table  class= "table table-bordered" style="width:100%">' +
                  '<thead>' +
                  '<tr>' +
                    '<th style="width:50%;text-align:left; font-size: 16px;">' + (TypeUsager != 'SAD' ? dateServer : DateRdv + ' ' + HeureRdv + '&nbsp;&nbsp;');

            var content2 =
                             '</th>' +
                              '<th style="width:50%; font-size: 16px;text-align:right">' + 'COVID-19' + '</th>' +
                            '</tr>' +
                            '</thead>' +
                            '<tbody>' +
                            '<tr style="box-shadow: inset 0px -2px 0px silver;">' +
                              '<td style="font-size: 11px;">' + Site + '</td>' +
