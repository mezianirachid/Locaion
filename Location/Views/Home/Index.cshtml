<!-- Modal pour l'ajout / édition d'appartement -->
<div id="apartmentModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h3 id="modalTitle">Ajouter une annonce</h3>
        <form id="apartmentForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" id="apartmentId" name="Id" value="0" />

            <div class="form-group">
                <label>Titre *</label>
                <input type="text" id="txtTitre" name="Titre" required />
            </div>

            <div class="form-group">
                <label>Description *</label>
                <textarea id="txtDescription" name="Description" rows="3" required></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Prix ($) *</label>
                    <input type="number" step="0.01" id="txtPrix" name="PrixPublic" required />
                </div>
                <div class="form-group">
                    <label>Surface (m²) *</label>
                    <input type="number" step="0.01" id="txtSuperficie" name="Superficie" required />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Nb chambres *</label>
                    <input type="number" id="txtNbChambres" name="NbEtages" required />
                </div>
                <div class="form-group">
                    <label>Nb salles de bain *</label>
                    <input type="number" id="txtNbSdB" name="NbSalleBain" required />
                </div>
            </div>

            <div class="form-group">
                <label>Adresse / localisation *</label>
                <input type="text" id="txtAdresse" name="AdresseAppartement" required />
            </div>

            <div class="form-group">
                <label>Badge (optionnel)</label>
                <input type="text" id="txtBadge" name="Badge" placeholder="ex: Coup de cœur" />
            </div>

            <div class="form-group">
                <label>Photos de l’appartement</label>
                <input type="file" id="fileImages" name="imageFiles" multiple accept="image/*" />
                <small>Vous pouvez sélectionner plusieurs photos. La première sera l'image principale. (Laissez vide pour conserver les photos existantes lors de l'édition.)</small>
            </div>

            <div class="form-group">
                <label>Statut</label>
                <select id="selStatut" name="StatutAppartement">
                    <option value="A">Actif</option>
                    <option value="I">Inactif</option>
                </select>
            </div>

            <button type="submit" class="btn-save">Enregistrer</button>
        </form>
    </div>
</div>

<!-- Modal de galerie photo -->
<div id="photoModal" class="modal">
    <div class="modal-content" style="max-width: 800px;">
        <span class="close" id="closePhotoModal">&times;</span>
        <div id="photoCarousel" style="text-align: center;">
            <img id="currentPhoto" src="" alt="Photo" style="max-width: 100%; max-height: 70vh; border-radius: 12px; box-shadow: 0 20px 40px rgba(0,0,0,0.4);" />
            <div style="margin-top: 15px;">
                <button id="prevPhoto" class="btn-nav">❮ Précédent</button>
                <button id="nextPhoto" class="btn-nav">Suivant ❯</button>
            </div>
            <div id="photoCounter" style="color: var(--dark); margin-top: 10px; font-weight: 600;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Variables globales
        let apartmentsData = [];
        let filteredApartments = [];
        let isAdmin = @(isAdmin ? "true" : "false");

        // Notifications
        function showNotification(message, type) {
            const $notif = $('#notification');
            if (!$notif.length) return;
            $notif.text(message)
                .removeClass()
                .addClass('notification ' + (type || 'info'))
                .addClass('show');
            setTimeout(function () {
                $notif.removeClass('show');
            }, 5000);
        }

        // Formatage du prix
        function formatPrice(value) {
            const number = parseFloat(value || 0);
            return number.toLocaleString('fr-CA') + ' $/mois';
        }

        // Troncature du texte
        function truncateText(text, maxLength) {
            if (!text) return '';
            return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        }

        // Affichage d'un état vide
        function renderEmptyState(containerSelector, message) {
            $(containerSelector).html(`
                <div class="empty-state-v2">
                    <i class="fas fa-home" style="font-size:2rem; margin-bottom:12px; color:var(--primary);"></i>
                    <p>${message}</p>
                </div>
            `);
        }

        // Création d'une carte premium
        function createPremiumCard(apartment) {
            const defaultImage = '@Url.Content("~/UploadedFiles/default.jpg")';
            const imageUrl = apartment.Images ? apartment.Images : defaultImage;
            const description = truncateText(apartment.Description || 'Appartement confortable disponible à la location.', 120);

            let photoBadge = '';
            if (apartment.ImagesCount && apartment.ImagesCount > 1) {
                photoBadge = `<span class="photo-count-badge">+${apartment.ImagesCount-1}</span>`;
            }

            let photoButton = '';
            if (apartment.ImagesCount > 0) {
                photoButton = `<button class="view-photos-btn" data-images='${JSON.stringify(apartment.AllImages)}'><i class="fas fa-images"></i> Voir les photos (${apartment.ImagesCount})</button>`;
            }

            let adminButtons = '';
            if (isAdmin) {
                adminButtons = `
                    <div class="admin-card-actions">
                        <button class="btn-edit" data-id="${apartment.Id}" title="Modifier"><i class="fas fa-edit"></i></button>
                        <button class="btn-delete" data-id="${apartment.Id}" title="Supprimer"><i class="fas fa-trash-alt"></i></button>
                    </div>
                `;
            }

            return `
                <article class="premium-card">
                    <div class="premium-visual">
                        <img src="${imageUrl}" alt="${apartment.Titre || 'Appartement'}" onerror="this.src='${defaultImage}'" />
                        <div class="premium-label">${apartment.Badge || 'En vedette'}</div>
                        <div class="premium-price">${formatPrice(apartment.PrixPublic)}</div>
                        ${photoBadge}
                    </div>
                    <div class="premium-body">
                        <h3>${apartment.Titre || 'Appartement sans titre'}</h3>
                        <div class="premium-loc">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>${apartment.AdresseAppartement || 'Emplacement non précisé'}</span>
                        </div>
                        <div class="premium-desc">${description}</div>
                        <div class="premium-meta">
                            <div><span>Chambres</span><strong>${apartment.NbEtages || 0}</strong></div>
                            <div><span>SDB</span><strong>${apartment.NbSalleBain || 0}</strong></div>
                            <div><span>Surface</span><strong>${apartment.Superficie || 0} m²</strong></div>
                        </div>
                        ${photoButton}
                        ${adminButtons}
                    </div>
                </article>
            `;
        }

        // Création d'une carte catalogue
        function createCatalogCard(apartment) {
            const defaultImage = '@Url.Content("~/UploadedFiles/default.jpg")';
            const imageUrl = apartment.Images ? apartment.Images : defaultImage;
            const description = truncateText(apartment.Description || 'Bel appartement disponible à la location.', 115);

            let photoBadge = '';
            if (apartment.ImagesCount && apartment.ImagesCount > 1) {
                photoBadge = `<span class="photo-count-badge">+${apartment.ImagesCount-1}</span>`;
            }

            let photoButton = '';
            if (apartment.ImagesCount > 0) {
                photoButton = `<button class="view-photos-btn" data-images='${JSON.stringify(apartment.AllImages)}'><i class="fas fa-images"></i> Voir les photos (${apartment.ImagesCount})</button>`;
            }

            let adminButtons = '';
            if (isAdmin) {
                adminButtons = `
                    <div class="admin-card-actions">
                        <button class="btn-edit" data-id="${apartment.Id}" title="Modifier"><i class="fas fa-edit"></i></button>
                        <button class="btn-delete" data-id="${apartment.Id}" title="Supprimer"><i class="fas fa-trash-alt"></i></button>
                    </div>
                `;
            }

            return `
                <article class="catalog-card">
                    <div class="catalog-image">
                        <img src="${imageUrl}" alt="${apartment.Titre || 'Appartement'}" onerror="this.src='${defaultImage}'" />
                        <div class="catalog-tag">${apartment.Badge || 'Disponible'}</div>
                        ${photoBadge}
                    </div>
                    <div class="catalog-body">
                        <div class="catalog-topline">
                            <h3>${apartment.Titre || 'Appartement sans titre'}</h3>
                            <div class="catalog-price">${formatPrice(apartment.PrixPublic)}</div>
                        </div>
                        <div class="catalog-location">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>${apartment.AdresseAppartement || 'Emplacement non précisé'}</span>
                        </div>
                        <div class="catalog-desc">${description}</div>
                        <div class="catalog-features">
                            <span class="catalog-feature"><i class="fas fa-bed"></i> ${apartment.NbEtages || 0} ch.</span>
                            <span class="catalog-feature"><i class="fas fa-bath"></i> ${apartment.NbSalleBain || 0} sdb</span>
                            <span class="catalog-feature"><i class="fas fa-vector-square"></i> ${apartment.Superficie || 0} m²</span>
                        </div>
                        ${photoButton}
                        <div class="catalog-actions">
                            <a href="#contact" class="catalog-btn primary">Demander une visite</a>
                            <a href="#contact" class="catalog-btn secondary">Plus d’infos</a>
                        </div>
                        ${adminButtons}
                    </div>
                </article>
            `;
        }

        // Rendu des appartements
        function renderApartments() {
            const featured = filteredApartments.slice(0, 3);
            const $featured = $('#featuredApartments');
            const $all = $('#allApartments');

            if (featured.length === 0) {
                renderEmptyState('#featuredApartments', 'Aucun appartement premium pour le moment.');
            } else {
                $featured.html(featured.map(createPremiumCard).join(''));
            }

            if (filteredApartments.length === 0) {
                renderEmptyState('#allApartments', 'Aucun appartement ne correspond à votre recherche.');
            } else {
                $all.html(filteredApartments.map(createCatalogCard).join(''));
            }

            $('#totalApartments').text(apartmentsData.length);
            $('#resultsCount').text(filteredApartments.length + ' résultat(s)');
        }

        // Application des filtres
        function applyFilters() {
            const keyword = ($('#searchKeyword').val() || '').toLowerCase().trim();
            const bedrooms = $('#searchBedrooms').val();
            const maxPrice = $('#searchMaxPrice').val();

            filteredApartments = apartmentsData.filter(function (apt) {
                const title = (apt.Titre || '').toLowerCase();
                const location = (apt.AdresseAppartement || '').toLowerCase();
                const description = (apt.Description || '').toLowerCase();

                const matchesKeyword = !keyword || title.includes(keyword) || location.includes(keyword) || description.includes(keyword);
                const matchesBedrooms = !bedrooms || parseInt(apt.NbEtages || 0) >= parseInt(bedrooms);
                const matchesPrice = !maxPrice || parseFloat(apt.PrixPublic || 0) <= parseFloat(maxPrice);

                return matchesKeyword && matchesBedrooms && matchesPrice;
            });

            renderApartments();
        }

        // Chargement des appartements depuis le serveur
        function loadApartments() {
            $.ajax({
                url: '@Url.Action("GetApartments", "Admin")',
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    apartmentsData = response || [];
                    filteredApartments = apartmentsData.slice();
                    renderApartments();
                },
                error: function () {
                    apartmentsData = [];
                    filteredApartments = [];
                    renderEmptyState('#featuredApartments', 'Impossible de charger les appartements.');
                    renderEmptyState('#allApartments', 'Impossible de charger les appartements.');
                    $('#resultsCount').text('0 résultat');
                    showNotification('Impossible de charger les appartements.', 'error');
                }
            });
        }

        // Gestion de la modale d'édition
        const editModal = document.getElementById('apartmentModal');
        const editSpan = document.getElementsByClassName('close')[0];
        editSpan.onclick = function() { editModal.style.display = 'none'; }
        window.onclick = function(event) {
            if (event.target == editModal) editModal.style.display = 'none';
        }

        // Ouverture du modal pour ajout
        $('#btnAddApartment').on('click', function() {
            $('#apartmentForm')[0].reset();
            $('#apartmentId').val('0');
            $('#modalTitle').text('Ajouter une annonce');
            editModal.style.display = 'block';
        });

        // Ouverture du modal pour édition
        function openEditModal(id) {
            $.ajax({
                url: '@Url.Action("GetApartment", "Admin")/' + id,
                type: 'GET',
                success: function(apt) {
                    $('#apartmentId').val(apt.Id);
                    $('#txtTitre').val(apt.Titre);
                    $('#txtDescription').val(apt.Description);
                    $('#txtPrix').val(apt.PrixPublic);
                    $('#txtSuperficie').val(apt.Superficie);
                    $('#txtNbChambres').val(apt.NbEtages);
                    $('#txtNbSdB').val(apt.NbSalleBain);
                    $('#txtAdresse').val(apt.AdresseAppartement);
                    $('#txtBadge').val(apt.Badge);
                    $('#selStatut').val(apt.StatutAppartement);
                    $('#modalTitle').text('Modifier l\'annonce');
                    editModal.style.display = 'block';
                },
                error: function() {
                    showNotification('Erreur lors du chargement de l\'annonce.', 'error');
                }
            });
        }

        // Suppression d'une annonce
        function deleteApartment(id) {
            if (!confirm('Voulez-vous vraiment supprimer cette annonce ?')) return;
            $.ajax({
                url: '@Url.Action("DeleteApartment", "Admin")/' + id,
                type: 'POST',
                data: { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                success: function(response) {
                    if (response.success) {
                        showNotification(response.message, 'success');
                        loadApartments();
                    } else {
                        showNotification(response.message, 'error');
                    }
                },
                error: function() {
                    showNotification('Erreur de connexion.', 'error');
                }
            });
        }

        // Soumission du formulaire (ajout / édition)
        $('#apartmentForm').on('submit', function(e) {
            e.preventDefault();

            var formData = new FormData(this);
            var id = $('#apartmentId').val();
            var url = id == '0' ? '@Url.Action("AddApartment", "Admin")' : '@Url.Action("EditApartment", "Admin")';

            $.ajax({
                url: url,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        showNotification(response.message, 'success');
                        editModal.style.display = 'none';
                        loadApartments();
                    } else {
                        showNotification(response.message, 'error');
                    }
                },
                error: function() {
                    showNotification('Erreur de connexion.', 'error');
                }
            });
        });

        // Délégation d'événements pour les boutons Edit / Delete
        $(document).on('click', '.btn-edit', function() {
            var id = $(this).data('id');
            openEditModal(id);
        });

        $(document).on('click', '.btn-delete', function() {
            var id = $(this).data('id');
            deleteApartment(id);
        });

        // ========== GESTION DE LA GALERIE PHOTO ==========
        let currentPhotoIndex = 0;
        let currentPhotoList = [];

        function openPhotoModal(images) {
            currentPhotoList = images;
            currentPhotoIndex = 0;
            if (currentPhotoList.length === 0) return;
            showCurrentPhoto();
            document.getElementById('photoModal').style.display = 'block';
        }

        function showCurrentPhoto() {
            const img = document.getElementById('currentPhoto');
            img.src = currentPhotoList[currentPhotoIndex];
            document.getElementById('photoCounter').innerText = (currentPhotoIndex + 1) + ' / ' + currentPhotoList.length;
        }

        $(document).on('click', '.view-photos-btn', function() {
            const images = $(this).data('images');
            openPhotoModal(images);
        });

        $('#prevPhoto').on('click', function() {
            if (currentPhotoList.length === 0) return;
            currentPhotoIndex = (currentPhotoIndex - 1 + currentPhotoList.length) % currentPhotoList.length;
            showCurrentPhoto();
        });

        $('#nextPhoto').on('click', function() {
            if (currentPhotoList.length === 0) return;
            currentPhotoIndex = (currentPhotoIndex + 1) % currentPhotoList.length;
            showCurrentPhoto();
        });

        $('#closePhotoModal').on('click', function() {
            document.getElementById('photoModal').style.display = 'none';
        });

        // Fermer la modale photo en cliquant en dehors
        window.onclick = function(event) {
            const modal = document.getElementById('photoModal');
            if (event.target == modal) modal.style.display = 'none';
        }

        // ========== FORMULAIRE DE CONTACT ==========
        $('#contactForm').on('submit', function (e) {
            e.preventDefault();

            $('.error').hide();

            const token = $('input[name="__RequestVerificationToken"]').val();
            const name = $('#name').val().trim();
            const email = $('#email').val().trim();
            const phone = $('#phone').val().trim();
            const message = $('#message').val().trim();

            let isValid = true;

            if (!name) {
                $('#nameError').show();
                isValid = false;
            }

            if (!email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                $('#emailError').show();
                isValid = false;
            }

            if (!phone || !/^[0-9\s\-+()]{8,}$/.test(phone)) {
                $('#phoneError').show();
                isValid = false;
            }

            if (!message) {
                $('#messageError').show();
                isValid = false;
            }

            if (!isValid) return false;

            $('#submitBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Envoi...');
            $('#loading').show();

            $.ajax({
                url: '@Url.Action("SendEmail", "Home")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token,
                    name: name,
                    email: email,
                    phone: phone,
                    message: message
                },
                success: function (resp) {
                    if (resp.success) {
                        // Cacher le formulaire et afficher le message de succès
                        $('#contactForm').hide();
                        $('#contactSuccessMessage').show();
                    } else {
                        showNotification(resp.message, 'error');
                    }
                },
                error: function () {
                    showNotification('Erreur de connexion.', 'error');
                },
                complete: function () {
                    $('#submitBtn').prop('disabled', false).html('<i class="fas fa-paper-plane"></i> Envoyer le message');
                    $('#loading').hide();
                }
            });
        });

        // Bouton pour renvoyer un autre message
        $('#sendAnotherMessage').on('click', function() {
            $('#contactForm')[0].reset();
            $('#contactForm').show();
            $('#contactSuccessMessage').hide();
        });

        // Initialisation
        $(document).ready(function () {
            loadApartments();

            $('#searchBtn').on('click', function () {
                applyFilters();
                $('html, body').animate({
                    scrollTop: $('#catalogue').offset().top - 85
                }, 450);
            });

            $('#searchKeyword, #searchBedrooms, #searchMaxPrice').on('keyup change', function (e) {
                if (e.type === 'keyup' && e.key !== 'Enter') {
                    return;
                }
                applyFilters();
            });

            $('.chip-filter').on('click', function () {
                $('.chip-filter').removeClass('active');
                $(this).addClass('active');

                const filter = $(this).data('filter');
                if (filter === 'all') {
                    $('#searchBedrooms').val('');
                } else {
                    $('#searchBedrooms').val(filter);
                }

                applyFilters();
            });
        });
    </script>
}