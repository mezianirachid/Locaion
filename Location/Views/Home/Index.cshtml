@{
    ViewBag.Title = "Accueil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdmin = User.IsInRole("Admin");
}

@section Styles {
    <style>
        /* ========== STYLES EXISTANTS (conservés à l'identique) ========== */
        .home-v2 {
            background: radial-gradient(circle at top left, rgba(0,94,184,0.08), transparent 28%), radial-gradient(circle at bottom right, rgba(255,209,102,0.14), transparent 30%), #ffffff;
            overflow: hidden;
        }

        .hero-v2 {
            padding: 55px 0 35px;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 28px;
            align-items: stretch;
        }

        .hero-panel {
            position: relative;
            min-height: 620px;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 18px 45px rgba(0,0,0,0.10);
            background: linear-gradient(120deg, rgba(0,0,0,0.58), rgba(0,0,0,0.28)), url('https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
            color: white;
            display: flex;
            align-items: flex-end;
        }

        .hero-overlay-content {
            padding: 45px;
            width: 100%;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.14);
            border: 1px solid rgba(255,255,255,0.20);
            color: #fff;
            padding: 8px 14px;
            border-radius: 999px;
            font-size: 0.88rem;
            font-weight: 600;
            margin-bottom: 18px;
            backdrop-filter: blur(4px);
        }

        .hero-overlay-content h1 {
            font-size: 3.4rem;
            line-height: 1.08;
            margin-bottom: 18px;
            font-family: 'Playfair Display', serif;
            max-width: 720px;
        }

        .hero-overlay-content p {
            font-size: 1.08rem;
            max-width: 640px;
            color: rgba(255,255,255,0.92);
            margin-bottom: 28px;
        }

        .hero-cta {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .btn-hero-primary, .btn-hero-secondary {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 14px 22px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 700;
            transition: var(--transition);
        }

        .btn-hero-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            box-shadow: 0 12px 24px rgba(0,94,184,0.28);
        }

            .btn-hero-primary:hover {
                transform: translateY(-2px);
                color: white;
            }

        .btn-hero-secondary {
            background: rgba(255,255,255,0.14);
            color: white;
            border: 1px solid rgba(255,255,255,0.26);
        }

            .btn-hero-secondary:hover {
                background: rgba(255,255,255,0.22);
                color: white;
            }

        .hero-mini-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(120px, 1fr));
            gap: 14px;
            max-width: 700px;
        }

        .hero-mini-stat {
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.14);
            border-radius: 18px;
            padding: 16px;
            backdrop-filter: blur(3px);
        }

            .hero-mini-stat strong {
                display: block;
                font-size: 1.6rem;
                margin-bottom: 4px;
            }

            .hero-mini-stat span {
                font-size: 0.92rem;
                color: rgba(255,255,255,0.92);
            }

        .search-side {
            background: white;
            border: 1px solid var(--border);
            border-radius: 28px;
            box-shadow: 0 18px 40px rgba(0,0,0,0.07);
            padding: 28px;
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .search-side-head h2 {
            font-size: 1.9rem;
            color: var(--dark);
            margin-bottom: 8px;
            font-family: 'Playfair Display', serif;
        }

        .search-side-head p {
            color: var(--gray);
            margin: 0;
        }

        .search-card-block {
            background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
            border: 1px solid #e7eef7;
            border-radius: 20px;
            padding: 18px;
        }

            .search-card-block h3 {
                font-size: 1rem;
                color: var(--primary);
                margin-bottom: 14px;
            }

        .search-stack {
            display: grid;
            gap: 14px;
        }

            .search-stack input, .search-stack select, .contact-form-v2 input, .contact-form-v2 textarea {
                width: 100%;
                border: 1px solid #d8e0ea;
                border-radius: 14px;
                padding: 14px 15px;
                font-size: 15px;
                outline: none;
                transition: var(--transition);
                background: #fff;
            }

                .search-stack input:focus, .search-stack select:focus, .contact-form-v2 input:focus, .contact-form-v2 textarea:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 4px rgba(0,94,184,0.10);
                }

        .search-main-btn {
            width: 100%;
            border: none;
            border-radius: 14px;
            padding: 15px 18px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            cursor: pointer;
            transition: var(--transition);
        }

            .search-main-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 25px rgba(0,94,184,0.22);
            }

        .search-tips {
            display: grid;
            gap: 10px;
        }

        .search-tip {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            background: #fff;
            border: 1px solid #ecf1f6;
            border-radius: 16px;
            padding: 14px;
        }

            .search-tip i {
                width: 38px;
                height: 38px;
                min-width: 38px;
                border-radius: 50%;
                background: rgba(0,94,184,0.10);
                color: var(--primary);
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .section-v2 {
            padding: 80px 0 20px;
        }

        .section-header-v2 {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 20px;
            margin-bottom: 34px;
            flex-wrap: wrap;
        }

            .section-header-v2 .text h2 {
                font-size: 2.3rem;
                color: var(--dark);
                font-family: 'Playfair Display', serif;
                margin-bottom: 10px;
            }

            .section-header-v2 .text p {
                color: var(--gray);
                max-width: 700px;
                margin: 0;
            }

        .section-link {
            text-decoration: none;
            color: var(--primary);
            font-weight: 700;
        }

        .value-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
        }

        .value-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 24px;
            box-shadow: 0 10px 24px rgba(0,0,0,0.05);
            transition: var(--transition);
        }

            .value-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 16px 30px rgba(0,0,0,0.08);
            }

        .value-icon {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: linear-gradient(135deg, rgba(0,94,184,0.12), rgba(255,209,102,0.25));
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            margin-bottom: 16px;
        }

        .value-card h3 {
            font-size: 1.15rem;
            margin-bottom: 10px;
            color: var(--dark);
        }

        .value-card p {
            margin: 0;
            color: var(--gray);
            font-size: 0.95rem;
        }

        .premium-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 26px;
        }

        .premium-card {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid var(--border);
            box-shadow: 0 12px 28px rgba(0,0,0,0.06);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .premium-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 34px rgba(0,0,0,0.09);
            }

        .premium-visual {
            position: relative;
            height: 250px;
            overflow: hidden;
            background: #edf3f9;
        }

            .premium-visual img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform .45s ease;
            }

        .premium-card:hover .premium-visual img {
            transform: scale(1.06);
        }

        .premium-label {
            position: absolute;
            top: 16px;
            left: 16px;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            padding: 7px 12px;
            border-radius: 999px;
            font-size: 0.82rem;
            font-weight: 700;
        }

        .premium-price {
            position: absolute;
            right: 16px;
            bottom: 16px;
            background: rgba(255,255,255,0.96);
            color: var(--primary);
            padding: 10px 14px;
            border-radius: 14px;
            font-weight: 700;
            box-shadow: 0 10px 20px rgba(0,0,0,0.10);
        }

        .premium-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

            .premium-body h3 {
                font-size: 1.25rem;
                color: var(--dark);
                margin-bottom: 8px;
            }

        .premium-loc {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--gray);
            margin-bottom: 14px;
        }

        .premium-desc {
            color: #596270;
            font-size: 0.94rem;
            line-height: 1.7;
            margin-bottom: 18px;
            min-height: 70px;
        }

        .premium-meta {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: auto;
            padding-top: 16px;
            border-top: 1px solid #edf1f5;
        }

            .premium-meta div {
                background: #f8fbff;
                border: 1px solid #e5eef8;
                border-radius: 14px;
                text-align: center;
                padding: 12px 8px;
            }

            .premium-meta span {
                display: block;
                color: var(--gray);
                font-size: 0.82rem;
                margin-bottom: 4px;
            }

            .premium-meta strong {
                color: var(--dark);
                font-size: 0.95rem;
            }

        .feed-layout {
            display: grid;
            grid-template-columns: 1.3fr 0.7fr;
            gap: 26px;
        }

        .catalog-shell {
            background: white;
            border: 1px solid var(--border);
            border-radius: 26px;
            padding: 26px;
            box-shadow: 0 14px 30px rgba(0,0,0,0.05);
        }

        .toolbar-v2 {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .chip-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .chip-filter {
            border: 1px solid #d9e4ef;
            background: #fff;
            color: var(--dark);
            border-radius: 999px;
            padding: 10px 16px;
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
        }

            .chip-filter.active, .chip-filter:hover {
                background: linear-gradient(135deg, var(--primary), var(--primary-dark));
                border-color: var(--primary);
                color: #fff;
            }

        .results-count {
            color: var(--gray);
            font-weight: 500;
        }

        .catalog-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
        }

        .catalog-card {
            border: 1px solid #e7edf4;
            border-radius: 22px;
            overflow: hidden;
            background: #fff;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }

            .catalog-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 16px 30px rgba(0,0,0,0.07);
            }

        .catalog-image {
            position: relative;
            height: 220px;
            background: #f0f4f8;
        }

            .catalog-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .catalog-tag {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(0,0,0,0.62);
            color: #fff;
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .catalog-body {
            padding: 18px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .catalog-topline {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: start;
            margin-bottom: 10px;
        }

            .catalog-topline h3 {
                font-size: 1.08rem;
                color: var(--dark);
                margin: 0;
            }

        .catalog-price {
            color: var(--primary);
            font-weight: 800;
            white-space: nowrap;
        }

        .catalog-location {
            color: var(--gray);
            font-size: 0.92rem;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .catalog-desc {
            color: #5c6572;
            font-size: 0.92rem;
            margin-bottom: 14px;
            line-height: 1.65;
            min-height: 68px;
        }

        .catalog-features {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }

        .catalog-feature {
            background: #f8fbff;
            border: 1px solid #e3edf7;
            color: #324154;
            border-radius: 999px;
            padding: 7px 11px;
            font-size: 0.84rem;
        }

        .catalog-actions {
            display: flex;
            gap: 10px;
            margin-top: auto;
        }

        .catalog-btn {
            flex: 1;
            text-align: center;
            text-decoration: none;
            padding: 11px 12px;
            border-radius: 12px;
            font-weight: 700;
            transition: var(--transition);
        }

            .catalog-btn.primary {
                background: linear-gradient(135deg, var(--primary), var(--primary-dark));
                color: white;
            }

            .catalog-btn.secondary {
                background: #f6f9fc;
                color: var(--primary);
                border: 1px solid #dce8f4;
            }

            .catalog-btn:hover {
                transform: translateY(-2px);
            }

        .side-stack {
            display: grid;
            gap: 22px;
        }

        .side-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 12px 26px rgba(0,0,0,0.05);
        }

            .side-card h3 {
                color: var(--dark);
                margin-bottom: 14px;
                font-size: 1.25rem;
            }

        .market-list {
            display: grid;
            gap: 12px;
        }

        .market-item {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 14px;
            background: #f8fbff;
            border: 1px solid #e4eef8;
        }

            .market-item strong {
                color: var(--dark);
            }

            .market-item span {
                color: var(--gray);
                font-size: 0.92rem;
            }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
        }

        .step-card {
            position: relative;
            background: white;
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 10px 24px rgba(0,0,0,0.05);
        }

        .step-number {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
        }

        .step-card h3 {
            margin-bottom: 10px;
            color: var(--dark);
            font-size: 1.12rem;
        }

        .step-card p {
            margin: 0;
            color: var(--gray);
            font-size: 0.95rem;
        }

        .district-grid-v2 {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr 0.9fr;
            gap: 22px;
        }

        .district-large, .district-small {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            min-height: 250px;
            box-shadow: 0 14px 30px rgba(0,0,0,0.08);
        }

        .district-large {
            min-height: 520px;
        }

            .district-large img, .district-small img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .district-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent, rgba(0,0,0,0.80));
            display: flex;
            align-items: end;
            padding: 22px;
            color: white;
        }

            .district-overlay h3 {
                font-size: 1.45rem;
                margin-bottom: 8px;
            }

            .district-overlay p {
                margin-bottom: 10px;
                color: rgba(255,255,255,0.92);
            }

        .district-pill {
            display: inline-block;
            padding: 7px 12px;
            border-radius: 999px;
            background: rgba(255,255,255,0.16);
            border: 1px solid rgba(255,255,255,0.22);
            font-size: 0.84rem;
            font-weight: 600;
        }

        .trust-section {
            padding: 80px 0 20px;
        }

        .trust-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 26px;
        }

        .testimonial-card, .contact-card-v2 {
            background: white;
            border: 1px solid var(--border);
            border-radius: 28px;
            padding: 28px;
            box-shadow: 0 14px 32px rgba(0,0,0,0.05);
        }

        .quote-icon {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: linear-gradient(135deg, rgba(0,94,184,0.12), rgba(255,209,102,0.24));
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 18px;
        }

        .testimonial-card blockquote {
            margin: 0 0 18px;
            font-size: 1.1rem;
            line-height: 1.8;
            color: #445060;
            font-style: normal;
        }

        .testimonial-author {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .testimonial-avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .contact-card-v2 h3 {
            font-size: 1.8rem;
            margin-bottom: 8px;
            color: var(--dark);
        }

        .contact-card-v2 p {
            color: var(--gray);
            margin-bottom: 20px;
        }

        .contact-info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
            margin-bottom: 20px;
        }

        .contact-info-box {
            background: #f8fbff;
            border: 1px solid #e3edf7;
            border-radius: 18px;
            padding: 16px;
        }

            .contact-info-box i {
                color: var(--primary);
                margin-bottom: 10px;
            }

            .contact-info-box strong {
                display: block;
                color: var(--dark);
                margin-bottom: 4px;
            }

            .contact-info-box span {
                color: var(--gray);
                font-size: 0.92rem;
            }

        .contact-form-v2 {
            display: grid;
            gap: 14px;
        }

            .contact-form-v2 textarea {
                min-height: 130px;
                resize: vertical;
            }

        .btn-send-v2 {
            border: none;
            border-radius: 14px;
            padding: 14px 18px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            font-weight: 700;
            cursor: pointer;
        }

        .empty-state-v2 {
            background: #f9fbfd;
            border: 1px dashed #cfdbe8;
            border-radius: 24px;
            padding: 36px 20px;
            text-align: center;
            color: var(--gray);
        }

        .loading-inline {
            display: none;
            color: var(--gray);
            font-size: 0.92rem;
        }

        .error {
            display: none;
            color: #dc3545;
            font-size: 0.88rem;
            margin-top: -4px;
        }

        /* Nouveaux styles pour l'administration */
        .admin-bar {
            background: #1e293b;
            color: white;
            padding: 16px 0;
            margin-bottom: 30px;
        }

            .admin-bar .container {
                display: flex;
                justify-content: flex-end;
            }

        .btn-admin {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border: none;
            color: white;
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 8px 16px rgba(0,94,184,0.3);
        }

            .btn-admin:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 20px rgba(0,94,184,0.4);
            }

        .admin-card-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 12px;
            border-top: 1px solid #edf1f5;
            padding-top: 12px;
        }

        .btn-edit, .btn-delete {
            border: none;
            background: transparent;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-edit {
            background: rgba(0,94,184,0.1);
            color: var(--primary);
        }

            .btn-edit:hover {
                background: var(--primary);
                color: white;
            }

        .btn-delete {
            background: rgba(220,53,69,0.1);
            color: #dc3545;
        }

            .btn-delete:hover {
                background: #dc3545;
                color: white;
            }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.6);
            backdrop-filter: blur(4px);
        }

        .modal-content {
            background-color: #fff;
            margin: 5% auto;
            padding: 30px;
            border-radius: 28px;
            max-width: 600px;
            width: 90%;
            box-shadow: 0 30px 60px rgba(0,0,0,0.4);
            position: relative;
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            line-height: 24px;
        }

            .close:hover {
                color: black;
            }

        #apartmentForm .form-group {
            margin-bottom: 18px;
        }

        #apartmentForm .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        #apartmentForm label {
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 6px;
            display: block;
        }

        #apartmentForm input:not([type="file"]),
        #apartmentForm textarea,
        #apartmentForm select {
            width: 100%;
            border: 1px solid #d8e0ea;
            border-radius: 12px;
            padding: 12px 15px;
            font-size: 15px;
        }

            #apartmentForm input:focus,
            #apartmentForm textarea:focus,
            #apartmentForm select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(0,94,184,0.1);
                outline: none;
            }

        .btn-save {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            border-radius: 30px;
            padding: 14px 24px;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            font-size: 1rem;
            transition: all 0.2s;
        }

            .btn-save:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 20px rgba(0,94,184,0.3);
            }

        /* Petit badge pour le nombre de photos */
        .photo-count-badge {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 4px 8px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            backdrop-filter: blur(2px);
        }

        /* Bouton "Voir les photos" */
        .view-photos-btn {
            background: none;
            border: none;
            color: var(--primary);
            cursor: pointer;
            margin-top: 8px;
            padding: 0;
            font-size: 0.9rem;
        }

            .view-photos-btn:hover {
                text-decoration: underline;
            }

        /* Galerie photo */
        #photoModal .modal-content {
            background: transparent;
            box-shadow: none;
        }

        #closePhotoModal {
            color: white;
            font-size: 40px;
            position: absolute;
            top: 10px;
            right: 20px;
            z-index: 2001;
        }

        .btn-nav {
            background: rgba(255,255,255,0.2);
            border: none;
            color: white;
            padding: 10px 20px;
            border-radius: 30px;
            margin: 0 5px;
            cursor: pointer;
            transition: background 0.2s;
        }

            .btn-nav:hover {
                background: rgba(255,255,255,0.4);
            }

        /* Styles pour le message de succès du contact */
        .success-message {
            text-align: center;
            padding: 30px 20px;
            background: #e8f5e9;
            border-radius: 24px;
            border: 1px solid #c8e6c9;
            margin-top: 20px;
        }

            .success-message i {
                font-size: 4rem;
                color: #2e7d32;
                margin-bottom: 20px;
            }

            .success-message h4 {
                font-size: 1.5rem;
                color: #1e293b;
                margin-bottom: 10px;
            }

            .success-message p {
                color: #2e7d32;
                margin-bottom: 20px;
            }

        #sendAnotherMessage {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 30px;
            cursor: pointer;
            font-weight: 700;
        }

        @@media (max-width: 1200px) {
            .value-grid, .steps-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .premium-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .district-grid-v2 {
                grid-template-columns: 1fr 1fr;
            }

            .district-large {
                min-height: 340px;
                grid-column: span 2;
            }
        }

        @@media (max-width: 992px) {
            .hero-grid, .feed-layout, .trust-grid, .contact-info-grid {
                grid-template-columns: 1fr;
            }

            .catalog-grid, .premium-grid, .value-grid, .steps-grid, .district-grid-v2 {
                grid-template-columns: 1fr;
            }

            .hero-panel {
                min-height: 540px;
            }

            .hero-overlay-content h1 {
                font-size: 2.6rem;
            }

            .district-large {
                grid-column: auto;
                min-height: 280px;
            }
        }

        @@media (max-width: 768px) {
            .hero-v2 {
                padding-top: 30px;
            }

            .hero-overlay-content {
                padding: 26px 22px;
            }

                .hero-overlay-content h1 {
                    font-size: 2.1rem;
                }

            .hero-mini-stats {
                grid-template-columns: 1fr;
            }

            .catalog-grid {
                grid-template-columns: 1fr;
            }

            .catalog-actions {
                flex-direction: column;
            }
        }
    </style>
}

