    <!--

    ~~~~~~~~~Start of the main content~~~~~~~~~~~~~

    -->

    <div class="container-fluid">
        <div class="row" style="border: 2px solid #ffd800">
            <h3>Notre adresse</h3>
            @*<span>@ViewBag.Agences</span>*@
            <div class="row cell-border" style="padding-left: 50px; padding-right: 50px;">
                <iframe src="https://www.google.com/maps/embed/v1/place?q=10250+Avenue+Plaza,+Montréal-Nord,+QC,+Canada&key=AIzaSyBFw0Qbyq9zTFTd-tUY6dZWTgaQzuU17R8"></iframe>
            </div>
            <hr />
            <div class="col-sm-6">
                <div class="col-xs-12 col-sm-6">
                    <h3>Adresse</h3>
                    <hr />
                    <p>10250 rue Plaza, Montréal</p>
                    <p><i class="fa fa-phone green" aria-hidden="true"></i><a href="tel:000000000">   ## ## ## ## ##</a></p>
                    <p><i class="fa fa-envelope purple" aria-hidden="true"></i><a href="mailto:agenceexempel@gmail.com">   agenceexempel@gmail.com</a></p>
                    <p>Ouvert du lundi au vendredi, de 8h00 à 12h00 et de 13h00 à 18h00</p>

                </div>
            </div>
            <div class="col-sm-6" style="border: 1px #808080">
                <div class="col-sm-12">
                    <h3>Nous contacter</h3>
                    <hr />
                    <div>
                        <small class="text-muted">Ces informations resteront confidentielles.</small>
                        <form class="m-b-2">
                            <div>
                                <fieldset class="form-group">
                                    <label for="firstname">Prénom</label>
                                    <input type="text" class="form-control" id="prenom" name="prenom">
                                    <label class="m-t-1" for="lastname">Nom</label>
                                    <input type="text" class="form-control" id="nom" name="nom">
                                    <label class="m-t-1" for="mail">Adresse mail</label>
                                    <input type="email" class="form-control" id="courriel" name="courriel">
                                    <label class="m-t-1" for="mail">Sujet</label>
                                    <input type="text" class="form-control" id="sujet" name="sujet">
                                    <label for="message">votre message</label>
                                    <textarea class="form-control" id="body" name="body" rows="6"></textarea>
                                </fieldset>
                                <button class="btn pull-left" id="contact_button" onclick="EnvoyerFormulaire()">Envoyer</button>
                            </div>
                            <br />
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>






    <!--

    ~~~~~~~~~End of the main content~~~~~~~~~~~~~

    -->
    <!--

    ~~~~~~~~~Start of the footer~~~~~~~~~~~~~

    -->

    <footer class="m-t-3">
        <!-- Start of the section -->
        <section class="container p-t-1 p-x-1 text-xs-center">
            <h4>Khodja Immo en bref</h4>
            <p>Khodja Immo est toujours à votre service. Vous pouvez nous contacter via le menu <b>Nous joindre</b> ou par téléphone au 438 ## ## ##</p>
            <!-- Footer navigation -->
            <nav class="row">
                <ul class="nav navbar-nav text-xs-center col-xs-9">
                    <li class="nav-item m-x-1">
                        <a class="nav-link" href="index.html">Accueil<span class="sr-only">(current)</span></a>
                    </li>
                    <li class="nav-item m-x-1">
                        <a class="nav-link" href="presentation.html">Présentation</a>
                    </li>
                    <li class="nav-item m-x-1">
                        <a class="nav-link" href="achat.html">Achat</a>
                    </li>
                    <li class="nav-item m-x-1">
                        <a class="nav-link" href="location.html">Location</a>
                    </li>

                    <li class="nav-item m-x-1">
                        <a class="nav-link" href="agences.html">Nous joindre</a>
                    </li>
                </ul>
                <!-- Social medias icons -->
                <figure class="col-xs-3 m-t-1">
                    <a href="#">
                        <i class="fa fa-facebook-official fa-2x m-r-1" aria-hidden="true"></i>
                    </a>
                    <a href="#">
                        <i class="fa fa-twitter fa-2x m-r-2" aria-hidden="true"></i>
                    </a>
                </figure>
            </nav>
            <!-- Copyright paragraphe -->
            <p>Khodja Immo 2023. &copy;Une réalisation <a href="#" target="_blank">Rachid Meziani</a></p>
        </section>

    </footer>

    <!--

    ~~~~~~~~~End of the footer~~~~~~~~~~~~~

    -->
    <script>
    function EnvoyerFormulaire() {
            var nom = $('#nom').val();
            var prenom = $('#prenom').val();
            var courriel = $('#courriel').val();
            var sujet = $('#sujet').val();
            sujet = sujet.toString();
            var body = $('#body').val();
            body = "Prénom:" + prenom.toString() + "----" + "Nom:" + nom.toString() + "----" + "Courriel:" + courriel.toString() + "----" + "----" + "----" + "----" + body.toString();
            body = body.toString();


            $.ajax({
                type: 'Get',
                url: '/Accueil/EnvoyerFormulaire',
                data: { sujet: sujet, body: body },
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (Data) {
                    alert("result: " + Data.statut);
                    alert("result: " + Data.data);
                },
                error: function (xhr) {
                    alert('Error: ' + xhr.statusText);
                },
            });
        };
        function validateForm() {

        }</script>


