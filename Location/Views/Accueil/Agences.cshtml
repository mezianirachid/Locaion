    -->
    <!-- Start of the header -->
    <header id="top">

        <!-- Back to top button -->
        <a href="#top" class="m-b-1"><i class="fa fa-arrow-up fa-lg hidden-sm-up pull-xs-right" aria-hidden="true"></i></a>
        <a href="#top" class="m-b-1 m-r-1"><i class="fa fa-arrow-up fa-2x hidden-sm-down pull-sm-right" aria-hidden="true"></i></a>

        <!-- Boxed layout inside the header -->
        <div class="container">
            <div class="row">
                <!-- Left logo -->
                <figure class="col-xs-5">
                    <img src="img/logo_immo_large.jpg" alt="logo Khodja immo" class="img-fluid hidden-md-down">
                    <img src="img/logo_immo_medium.jpg" alt="logo Khodja immo" class="img-fluid hidden-xs-down hidden-lg-up">
                    <img src="img/logo_immo_small.jpg" alt="logo Khodja immo" class="img-fluid hidden-sm-up">
                </figure>
                <!-- Main title on the right -->
                <aside class="col-xs-7 text-xs-center">
                    <h1>Nos services pour vous accompagner</h1>
                </aside>
            </div>
        </div>

    </header>
    <!-- end of the header -->
    <!-- Start of the navigation -->
    <nav>

        <!-- Personnal space icon -->
        <a href="#">
            <aside class="pull-xs-right m-r-2" id="personal_space">
                <i class="fa fa-user fa-3x m-r-1 hidden-xs-down" aria-hidden="true"></i>
                <i class="fa fa-user fa-2x m-r-1 hidden-sm-up" id="small_user" aria-hidden="true"></i>
                <a href="/Account/Login" class="btn btn-default stretched-link">&nbsp;&nbsp;&nbsp;Espace<br>de gestion</a>
            </aside>
        </a>
        <!-- Navigation -->
        <button class="navbar-toggler hidden-sm-up" type="button" data-toggle="collapse" data-target="#exCollapsingNavbar2">
            &#9776;
        </button>
        <div class="collapse navbar-toggleable-xs" id="exCollapsingNavbar2">
            <ul class="nav navbar-nav">
                <li class="nav-item m-x-1">
                    <a class="nav-link" href="Index">Accueil<span class="sr-only">(current)</span></a>
                </li>
                <li class="nav-item m-x-1">
                    <a class="nav-link" href="Presentation">Présentation</a>
                </li>
                <li class="nav-item m-x-1">
                    <a class="nav-link" href="Achat">Achat</a>
                </li>
                <li class="nav-item m-x-1">
                    <a class="nav-link" href="Location">Location</a>
                </li>

                <li class="nav-item m-x-1 on">
                    <a class="nav-link" href="agences.html">Nous joindre</a>
                </li>
            </ul>
        </div>
    </nav>
    <!-- End of the navigation -->
    <!-- Start of the jumbotron with main image -->
