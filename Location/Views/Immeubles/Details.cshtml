@model Location.DAL.Immeubles

@{
    ViewBag.Title = "Détails de l'immeuble";
}

<h2 class="mb-4"><i class="fas fa-building me-2"></i>Détails de l'immeuble</h2>

<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">@Html.DisplayFor(model => model.NomImmeuble)</h4>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h5 class="border-bottom pb-2"><i class="fas fa-info-circle me-2"></i>Informations générales</h5>
                <dl class="row">
                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.AdresseImmeuble)</dt>
                    <dd class="col-sm-7">@Html.DisplayFor(model => model.AdresseImmeuble)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.DescriptionImmeuble)</dt>
                    <dd class="col-sm-7">@Html.DisplayFor(model => model.DescriptionImmeuble)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.StatutImmeuble)</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-@(Model.StatutImmeuble == "A" ? "success" : "secondary")">
                            @(Model.StatutImmeuble == "A" ? "Actif" : "Inactif")
                        </span>
                    </dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Orientation)</dt>
                    <dd class="col-sm-7">@Html.DisplayFor(model => model.Orientation)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Annee)</dt>
                    <dd class="col-sm-7">@Html.DisplayFor(model => model.Annee)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Autre)</dt>
                    <dd class="col-sm-7">@Html.DisplayFor(model => model.Autre)</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="border-bottom pb-2"><i class="fas fa-chart-bar me-2"></i>Caractéristiques</h5>
                <dl class="row">
                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.nbEtages)</dt>
                    <dd class="col-sm-7"><i class="fas fa-layer-group me-1"></i> @Html.DisplayFor(model => model.nbEtages)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.nbStationnementsInt)</dt>
                    <dd class="col-sm-7"><i class="fas fa-warehouse me-1"></i> @Html.DisplayFor(model => model.nbStationnementsInt)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.nbStationnementsExt)</dt>
                    <dd class="col-sm-7"><i class="fas fa-car me-1"></i> @Html.DisplayFor(model => model.nbStationnementsExt)</dd>
                </dl>

                <h5 class="border-bottom pb-2 mt-4"><i class="fas fa-clock me-2"></i>Métadonnées</h5>
                <dl class="row">
                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.CreatedBy)</dt>
                    <dd class="col-sm-7">@Html.DisplayFor(model => model.CreatedBy)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.CreatedOn)</dt>
                    <dd class="col-sm-7">@Html.DisplayFor(model => model.CreatedOn)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.ModifiedBy)</dt>
                    <dd class="col-sm-7">@Html.DisplayFor(model => model.ModifiedBy)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(model => model.ModifiedOn)</dt>
                    <dd class="col-sm-7">@Html.DisplayFor(model => model.ModifiedOn)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">
            <i class="fas fa-edit me-1"></i>Modifier
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Retour à la liste
        </a>
    </div>
</div>