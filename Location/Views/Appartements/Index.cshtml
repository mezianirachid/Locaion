@model IEnumerable<Location.DAL.Appartements>

@{
    ViewBag.Title = "Appartements";
}

<h2 class="mb-4"><i class="fas fa-door-open me-2"></i>Gestion des appartements</h2>

<p>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus-circle me-1"></i>Ajouter un appartement
    </a>
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-door-open me-1"></i> Appartement @Html.DisplayFor(modelItem => item.AdresseAppartement)
                    </h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        <i class="fas fa-building text-muted me-2"></i> @Html.DisplayFor(modelItem => item.Immeubles.NomImmeuble)
                    </p>
                    <p class="card-text">
                        <i class="fas fa-tag text-muted me-2"></i> @Html.DisplayFor(modelItem => item.TypeAppartements.NomTypeAppartement)
                    </p>
                    <p class="card-text">
                        <i class="fas fa-vector-square text-muted me-2"></i> Superficie : @Html.DisplayFor(modelItem => item.Superficie)
                    </p>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-@(item.StatutAppartement == "A" ? "success" : "secondary")">
                            @(item.StatutAppartement == "A" ? "Disponible" : "Occupé")
                        </span>
                        <small class="text-muted">
                            <i class="fas fa-calendar-alt me-1"></i> @item.Annee
                        </small>
                    </div>
                    <div class="mt-3 d-flex justify-content-around">
                        <span title="Salle de bain"><i class="fas fa-bath"></i> @item.NbSalleBain</span>
                        <span title="Étages"><i class="fas fa-layer-group"></i> @item.NbEtages</span>
                        <span title="Balcons"><i class="fas fa-umbrella-beach"></i> @item.nbBalcons</span>
                    </div>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-between">
                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-warning">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-info-circle"></i> Détails
                    </a>
                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-trash-alt"></i> Supprimer
                    </a>
                </div>
            </div>
        </div>
    }
</div>