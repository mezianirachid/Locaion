@model IEnumerable<Location.Sites>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Liste des sites</h2>
<hr />

<p>
    @Html.ActionLink("Ajouter un site", "Create", null, new { @class = "btn btn-success btn-large" })
</p>
<table id="covid-data-table" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Réf site")
            </th>
            <th>
                @Html.DisplayName("Nom site")
            </th>
            <th>
                @Html.DisplayName("Emplacement site")
            </th>
            <th>
                @Html.DisplayName("Tél Contact")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NomSite)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmplacementSite)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TelephoneSite)
                </td>
                <td>
                    @Html.ActionLink("Éditer", "Edit", new { id = item.ID })
                    @*|@Html.ActionLink("Détails", "Details", new { id=item.ID })*@
                    @*| @Html.ActionLink("Delete", "Delete", new { id=item.ID })*@
                </td>
            </tr>
        }

    </tbody>
</table>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Content/bootstrap/js/jquery.dataTables.min.js"></script>
<script>
    $('#covid-data-table').DataTable({
        "dom": '<"top"if>rt<"bottom"lp>',
        "language": {
            "sProcessing": "Traitement en cours ...",
            "sLengthMenu": "Afficher _MENU_ lignes",
            "sZeroRecords": "Aucun résultat trouvé",
            "sEmptyTable": "Aucune donnée disponible",
            "sInfo": "Lignes _START_ à _END_ sur _TOTAL_",
            "sInfoEmpty": "Aucune ligne affichée",
            "sInfoFiltered": "(Filtrer un maximum de_MAX_)",
            "sInfoPostFix": "",
            "sSearch": "Rechercher:",
            "sUrl": "",
            "sInfoThousands": ",",
            "sLoadingRecords": "Chargement...",
            "oPaginate": {
                "sFirst": "Premier", "sLast": "Dernier", "sNext": "Suivant", "sPrevious": "Précédent"
            },
            "oAria": {
                "sSortAscending": ": Trier par ordre croissant", "sSortDescending": ": Trier par ordre décroissant"
            }
        }
    });
</script>



